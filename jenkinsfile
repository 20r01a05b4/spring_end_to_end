pipeline{
	agent any
		stages
		{
			stage('checkout'){
				steps{
					checkout scm
				}
			}
			stage('build the app'){
				steps{
					bat 'mvn clean install -DskipTests'
				}
			}
			stage('Check Jenkins Environment') {
    steps {
        withCredentials([
            string(credentialsId: 'db_username', variable: 'DB_USERNAME'),
            string(credentialsId: 'db_password', variable: 'DB_PASSWORD'),
            string(credentialsId: 'root_password', variable: 'ROOT_PASSWORD')
        ]) {
            bat '''
                echo ===== JENKINS VARIABLES =====

                echo DB_USERNAME=%DB_USERNAME%

                if defined DB_PASSWORD (
                    echo DB_PASSWORD=SET
                ) else (
                    echo DB_PASSWORD=NOT_SET
                )

                if defined ROOT_PASSWORD (
                    echo ROOT_PASSWORD=SET
                ) else (
                    echo ROOT_PASSWORD=NOT_SET
                )

                echo ===== END =====
            '''
        }
    }
}
			stage('run the container'){
				steps{
					withCredentials([
						string(credentialsId:'db_username',variable:'DB_USERNAME'),
						string(credentialsId:'db_password',variable:'DB_PASSWORD'),
						string(credentialsId:'root_password',variable:'ROOT_PASSWORD')
					]){
						
					
					bat 'docker-compose down'
					bat 'docker-compose up --build -d'
					}
				}
			}
		}	
		
	
}