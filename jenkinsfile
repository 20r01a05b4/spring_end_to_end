pipeline{
	agent any{
		stages
		{
			stage('checkout'){
				steps{
					checkout scm
				}
			}
			stage('build the app'){
				steps{
					bt 'maven clean install -DskipTests'
				}
			}
			stage('run the container'){
				steps{
					bt 'docker-compose down'
					bt 'docker-compose up --build'
				}
			}
		}	
		
	}
}